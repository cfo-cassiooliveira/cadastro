# Modelo do .env. Não preencha aqui: rode ./scripts/generate-env.sh (copia o segredo do ../keycloak/.env e a chave de log do ../legado/.env).
KC_CADASTRO_CLIENT_SECRET=

# --- Pseudonimização dos logs (ADR-0003 do ../graylog) -------------------------------
# Chave HMAC de 256 bits (Base64) que gera os campos <Campo>_token (Cpf_token, Email_token...).
# A API NÃO sobe sem ela. Deve ser a MESMA do ../legado no mesmo ambiente (correlação).
# ./scripts/generate-env.sh copia do ../legado/.env quando já existe lá; senão gera.
LOG_PSEUDONYMIZATION_KEY_K1=
# Rotação anual: ../legado/scripts/log-pseudonymization-key.sh k2 gera a k2 (ou copia daqui) e
# ./scripts/generate-env.sh a copia do ../legado/.env; depois CURRENT_KEY_ID=k2 nos dois. O Cadastro pesquisa
# com todas as chaves: mantenha a K1 até o fim da retenção dos logs (30 dias) e depois apague-a.
# Chave vazia = ausente; a API não sobe sem a atual.
LOG_PSEUDONYMIZATION_KEY_K2=
LOG_PSEUDONYMIZATION_CURRENT_KEY_ID=k1

# --- Importação em lote (spec 002 do ../rabbitmq; ADR-0007) --------------------------
# Chave AES-256 (Base64) dos dados pessoais das linhas. Gerada UMA vez por generate-env.sh; trocá-la torna ilegíveis as
# linhas já cifradas (rotação: nova versão k2 + PERSONAL_DATA_KEY_VERSION=k2, mantendo a k1 até o fim da retenção).
PERSONAL_DATA_KEY_K1=
# Versão da chave usada para cifrar novos valores (padrão k1).
PERSONAL_DATA_KEY_VERSION=k1
# Connection string do login cadastro_app (runtime, sem acesso ao dbo). A senha nasce no ../legado-cadastro-usuarios/.env.
CADASTRO_APP_CONNECTION=
# Connection string do login cadastro_migrator (só migrations: ./scripts/migrate-import-db.sh).
CADASTRO_MIGRATOR_CONNECTION=
# Senha do usuário cadastro-app do RabbitMQ (relay da outbox; sem permissão de configure). Nasce no ../rabbitmq/.env.
RABBITMQ_CADASTRO_APP_PASSWORD=
# Chave HMAC (Base64, >= 32 bytes) que assina o token do resumo do lote; a API não sobe sem ela.
USER_IMPORT_SUMMARY_KEY=

# --- Consumidor da importação (spec 002, C5a-C5c; docker-compose.import.yml) ---------
# Segredo do client cadastro-importer (conta de serviço que cria usuários sem senha). Nasce no ../keycloak/.env; generate-env.sh copia.
KC_CADASTRO_IMPORTER_CLIENT_SECRET=
# Chave HMAC (Base64, 256 bits) do Cadastro na API interna do Legado. Nasce no ../legado-cadastro-usuarios/.env (internal-credentials.sh); generate-env.sh copia.
LEGADO_INTERNAL_CADASTRO_KEY=
