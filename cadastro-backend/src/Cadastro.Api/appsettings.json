{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning"
      }
    }
  },
  "Logging": {
    "Pseudonymization": {
      "CurrentKeyId": "k1"
    }
  },
  "AllowedHosts": "*",
  "Oidc": {
    "Authority": "http://localhost:8180/realms/workspace",
    "MetadataAddress": "http://keycloak:8080/realms/workspace/.well-known/openid-configuration",
    "ClientId": "cadastro",
    "PublicOrigin": "http://localhost:4300",
    "RequireHttpsMetadata": true
  },
  "KeycloakAdmin": {
    "BaseUrl": "http://keycloak:8080/",
    "Realm": "workspace",
    "ClientId": "cadastro"
  }
}
