{
  "realm": "workspace",
  "enabled": true,
  "sslRequired": "none",
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "accessTokenLifespan": 600,
  "ssoSessionIdleTimeout": 1800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      { "name": "admin" },
      { "name": "user" },
      { "name": "offline_access" },
      { "name": "uma_authorization" },
      {
        "name": "default-roles-workspace",
        "composite": true,
        "composites": { "realm": ["offline_access", "uma_authorization", "user"] }
      }
    ]
  },
  "defaultRole": { "name": "default-roles-workspace", "composite": true, "clientRole": false },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"unmanagedAttributePolicy\":\"ENABLED\",\"attributes\":[{\"name\":\"username\",\"validations\":{\"length\":{\"min\":3,\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]}},{\"name\":\"email\",\"validations\":{\"email\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]}},{\"name\":\"firstName\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]}},{\"name\":\"lastName\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]}}]}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "cadastro",
      "enabled": true,
      "publicClient": false,
      "secret": "test-only-client-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "redirectUris": ["http://localhost:4300/bff/signin-oidc"],
      "webOrigins": [],
      "defaultClientScopes": ["basic", "acr", "roles"],
      "protocolMappers": [
        {
          "name": "login",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "optionalClientScopes": ["kc-admin-api"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4300/"
      }
    }
  ],
  "scopeMappings": [{ "client": "cadastro", "roles": ["admin", "user"] }],
  "clientScopeMappings": {
    "realm-management": [{ "client": "cadastro", "roles": ["view-users", "query-users", "manage-users"] }]
  },
  "users": [
    {
      "username": "service-account-cadastro",
      "enabled": true,
      "serviceAccountClientId": "cadastro",
      "clientRoles": { "realm-management": ["view-users", "query-users", "manage-users"] }
    },
    {
      "username": "usuario.teste",
      "enabled": true,
      "email": "usuario.teste@example.com",
      "emailVerified": true,
      "firstName": "Usuario",
      "lastName": "Teste",
      "attributes": {
        "mobilePhone": ["+5511900000000"],
        "postalCode": ["01001000"],
        "street": ["Praça da Sé"],
        "addressNumber": ["1"],
        "district": ["Sé"],
        "city": ["São Paulo"],
        "cityIbgeCode": ["3550308"],
        "state": ["SP"]
      },
      "credentials": [{ "type": "password", "value": "Test-Only-Password-1!", "temporary": false }],
      "realmRoles": ["default-roles-workspace"]
    },
    {
      "username": "admin.teste",
      "enabled": true,
      "email": "admin.teste@example.com",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Teste",
      "credentials": [{ "type": "password", "value": "Test-Only-Password-1!", "temporary": false }],
      "realmRoles": ["default-roles-workspace", "admin"]
    }
  ]
}
